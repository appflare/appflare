{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "biome.json",
    "tsconfig.json",
    "vitest.shared.ts",
    ".node-version",
    "docs/assets/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["APPFLARE_VERSION", "CATALOG_SNAPSHOT"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {},
    "lint": {},
    "format": {
      "cache": false
    },
    "test": {},
    "@appflare/docs#test": {
      "dependsOn": ["^build"]
    },
    "test:dist": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
