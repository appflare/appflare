{
  "name": "@appflare/pack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@appflare/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "appflare-pack": "./bin/appflare-pack.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "keygen": "node scripts/keygen.mjs",
    "test:dist": "node scripts/smoke-dist.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "bcryptjs": "3.0.3",
    "ignore": "5.3.1",
    "wrangler": "4.136.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@appflare/cf-api": "workspace:*",
    "@appflare/schema": "workspace:*"
  }
}
