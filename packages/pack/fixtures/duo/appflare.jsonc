{
  // Catalog manifest for the `duo` packer fixture: an app of two Workers.
  "slug": "duo",
  "name": "Duo",
  "summary": "Two Workers deployed together, used to exercise the packer.",
  "homepage": "https://github.com/appflare/appflare",
  "repo": "appflare/appflare",
  "license": "Apache-2.0",
  "categories": ["utilities"],
  "maintainers": ["appflare"],
  "source": { "ref": "v0.2.0", "sha": "0123456789abcdef0123456789abcdef01234567" },
  "install": {
    "tier": "artifact",
    "packageManager": "pnpm",
    "wranglerConfig": "web/wrangler.jsonc",
    "workerName": "duo",
    "workers": [
      { "name": "web", "wranglerConfig": "web/wrangler.jsonc", "primary": true },
      { "name": "jobs", "wranglerConfig": "jobs/wrangler.jsonc" }
    ]
  },
  "plan": "free",
  "requires": [],
  "secrets": [
    { "name": "SESSION_SECRET", "label": "Session secret", "generate": true, "workers": ["web"] },
    { "name": "SHARED_KEY", "label": "Shared key", "generate": true }
  ],
  "vars": [{ "name": "JOBS_URL", "label": "Jobs URL", "default": "{{workerUrl:jobs}}" }],
  "postInstall": [],
  "tokenPermissions": []
}
