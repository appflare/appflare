{
  "name": "@appflare/cf-api",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@appflare/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capabilities": {
      "@appflare/source": "./src/capabilities.ts",
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./dev": {
      "@appflare/source": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./capabilities": {
        "types": "./dist/capabilities.d.ts",
        "import": "./dist/capabilities.js"
      },
      "./dev": {
        "types": "./dist/dev.d.ts",
        "import": "./dist/dev.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "zod": "4.6.5"
  }
}
