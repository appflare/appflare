{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appflare.github.io/catalog/schema/v1.json",
  "title": "Appflare catalog manifest (appflare.jsonc)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "pattern": "^https:\\/\\/"
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/\\s]+\\/[^/\\s]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "ref",
        "sha"
      ],
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "artifact",
            "sandbox",
            "self-deploying"
          ]
        },
        "packageManager": {
          "type": "string",
          "enum": [
            "pnpm",
            "npm",
            "yarn",
            "bun"
          ]
        },
        "wranglerConfig": {
          "type": "string",
          "minLength": 1
        },
        "workerName": {
          "type": "string",
          "minLength": 1
        },
        "fixedWorkerName": {
          "type": "boolean"
        },
        "healthPath": {
          "type": "string",
          "pattern": "^\\/[^\\s?#]*$"
        },
        "healthMode": {
          "type": "string",
          "enum": [
            "default",
            "status-only"
          ],
          "description": "How the health check reads the Worker's answer. `\"default\"` counts redirects and 4xx answers as verified and server errors (5xx) as unhealthy. `\"status-only\"` counts any answer from the Worker itself as verified, server errors included: use it for apps whose health path sits behind Cloudflare Access or the app's own sign-in. Either way, connection failures and Cloudflare's error pages (such as `error code: 1042` while the route goes live) are retried. Defaults to `\"default\"`."
        },
        "buildCommand": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9@%+,./:=_ -]+$",
          "description": "One command the packer runs at the root of the checkout after installing dependencies (with install scripts disabled) and before bundling, for example `pnpm --filter @scope/web build`. Use it when the wrangler config has no `build.command`. It runs as a plain command without a shell, with no credentials in its environment, and the checkout's `node_modules/.bin` on its PATH, so pipes, redirects, quotes, variables, and environment assignments are not allowed. At most 256 characters."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "description": "The version shown for this entry when the repository's tag does not describe this app (monorepos); it must change whenever `source` moves."
        },
        "emailRouting": {
          "type": "object",
          "properties": {
            "catchAll": {
              "type": "boolean",
              "description": "Send every address of the zone that no other rule matches to the app (the zone's catch-all rule). The install refuses when the catch-all already sends mail somewhere else."
            },
            "rules": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?=[^@]{1,64}(?:@|$))[a-z0-9]+(?:[._+-][a-z0-9]+)*(?:@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+)?$"
              },
              "description": "Addresses to route to the app, one routing rule each: a local part such as `inbox` (becomes `inbox@<zone>`) or a full address in the chosen zone. The install refuses an address that already has a rule.",
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "description": "Email the app receives through Email Routing. The install form asks for one of the account's zones; the install turns Email Routing on there if it is off, then points the listed addresses (and, with `catchAll`, every other address) at the app's Worker, which must export an `email` handler. Uninstalling removes what the install added.",
          "anyOf": [
            {
              "required": [
                "catchAll"
              ],
              "properties": {
                "catchAll": {
                  "const": true
                }
              }
            },
            {
              "required": [
                "rules"
              ],
              "properties": {
                "rules": {
                  "minItems": 1
                }
              }
            }
          ]
        },
        "sandbox": {
          "type": "object",
          "properties": {
            "expectedMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120,
              "description": "About how many minutes one build of this app takes, measured on a `standard-1` build (or `instanceType`, when set). The manager multiplies it by the container's rates to show what each install or update costs before the admin confirms it. Whole minutes, 1 to 120; defaults to 10."
            },
            "instanceType": {
              "type": "string",
              "enum": [
                "standard-1",
                "standard-2"
              ],
              "description": "The container the build runs on: `standard-1` (1/2 vCPU, 4 GiB memory, 8 GB disk) or `standard-2` (1 vCPU, 6 GiB, 12 GB) for builds that run out of memory or disk on the smaller one. The larger container costs more per minute, which the manager's cost estimate reflects. Defaults to `\"standard-1\"`."
            }
          },
          "additionalProperties": false,
          "description": "How this app is built in the user's account, for `sandbox` tier entries only. Both fields feed the build cost the manager shows before each install and update."
        }
      },
      "required": [
        "tier",
        "packageManager",
        "wranglerConfig",
        "workerName"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "not": {
            "required": [
              "sandbox"
            ]
          }
        },
        {
          "properties": {
            "tier": {
              "const": "sandbox"
            }
          }
        }
      ]
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "paid"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "r2",
          "zone",
          "email-routing",
          "workers-ai",
          "browser-rendering",
          "containers"
        ]
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "help": {
            "type": "string"
          },
          "generate": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "label",
          "generate"
        ],
        "additionalProperties": false
      }
    },
    "vars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "help": {
            "type": "string"
          },
          "default": {
            "type": "string",
            "description": "Value the form starts with. `{{workerUrl}}` becomes the install's workers.dev URL (`https://<worker name>.<account subdomain>.workers.dev`, no trailing slash) and `{{workerName}}` its Worker name, filled in on every install and update. `{{workerUrl}}` is always the workers.dev address, even when a custom domain is attached. When the app's wrangler config gives this var a value that is not a string (an array, object, number, or boolean), the var reaches the Worker as JSON and `default` must be JSON text, for example `[\"{{workerUrl}}\"]`. Without `default`, the form starts with the wrangler config's value."
          },
          "required": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "label",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "postInstall": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "markdown"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "tokenPermissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "account",
              "zone",
              "user"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "vectorize": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "dimensions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1536
              },
              "metric": {
                "type": "string",
                "enum": [
                  "cosine",
                  "euclidean",
                  "dot-product"
                ]
              }
            },
            "required": [
              "dimensions",
              "metric"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "bump": {
      "type": "object",
      "properties": {
        "autoMerge": {
          "type": "boolean",
          "description": "Let the bump bot's pull request merge itself once the required checks, including the install check, pass. For entries whose maintainers trust upstream's tags to be releasable as they are."
        }
      },
      "required": [
        "autoMerge"
      ],
      "additionalProperties": false,
      "description": "How the catalog's bump bot treats this entry when its upstream moves."
    }
  },
  "required": [
    "slug",
    "name",
    "summary",
    "homepage",
    "repo",
    "license",
    "categories",
    "maintainers",
    "source",
    "install",
    "plan",
    "requires",
    "secrets",
    "vars",
    "postInstall",
    "tokenPermissions"
  ],
  "additionalProperties": false
}
