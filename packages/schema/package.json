{
  "name": "@appflare/schema",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@appflare/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog-display": {
      "@appflare/source": "./src/catalog-display/index.ts",
      "types": "./dist/catalog-display.d.ts",
      "import": "./dist/catalog-display.js"
    },
    "./links": {
      "@appflare/source": "./src/links.ts",
      "types": "./dist/links.d.ts",
      "import": "./dist/links.js"
    },
    "./json-schema/v1.json": "./json-schema/v1.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "json-schema"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./catalog-display": {
        "types": "./dist/catalog-display.d.ts",
        "import": "./dist/catalog-display.js"
      },
      "./links": {
        "types": "./dist/links.d.ts",
        "import": "./dist/links.js"
      },
      "./json-schema/v1.json": "./json-schema/v1.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "export-json-schema": "node scripts/export-json-schema.ts",
    "keygen": "node scripts/keygen.ts",
    "update-spdx-ids": "node scripts/update-spdx-ids.mjs",
    "codemod-manifest-v1": "node scripts/codemod-manifest-v1.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1"
  }
}
