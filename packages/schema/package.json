{
  "name": "@appflare/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@appflare/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./json-schema/v1.json": "./json-schema/v1.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "json-schema"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./json-schema/v1.json": "./json-schema/v1.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "export-json-schema": "node scripts/export-json-schema.ts",
    "keygen": "node scripts/keygen.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
