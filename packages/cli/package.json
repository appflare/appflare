{
  "name": "create-appflare",
  "version": "0.0.0",
  "private": false,
  "description": "Install Appflare, a self-hosted app manager for Cloudflare, into your own Cloudflare account.",
  "keywords": [
    "appflare",
    "cloudflare",
    "cloudflare-workers",
    "workers",
    "self-hosted",
    "installer",
    "create",
    "wrangler"
  ],
  "homepage": "https://appflare.dev",
  "bugs": {
    "url": "https://github.com/appflare/appflare/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appflare/appflare.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "@appflare/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "create-appflare": "./bin/appflare.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:dist": "node scripts/smoke-dist.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "wrangler": "4.136.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@appflare/pack": "workspace:*",
    "@appflare/schema": "workspace:*"
  }
}
