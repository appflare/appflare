{
  // The Appflare sandbox Worker: an optional Worker, Workers Paid only, that builds
  // `sandbox` tier apps inside a Cloudflare Sandbox container in the user's own
  // account. The manager reaches it only through a service binding to the
  // `SandboxBuilds` entrypoint; it has no public URL.
  //
  // Users never deploy this file: the manager's "Enable sandbox builds" job uploads the
  // same configuration from the sandbox Worker's signed release
  // (apps/manager/src/sandbox/deploy-plan.ts). This file is for tests and packing.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "appflare-sandbox",
  // Pinned to the Appflare Dev account so local wrangler commands cannot target
  // another account. The packer strips it from release artifacts.
  "account_id": "e56348678f83352622c33faa66f43c13",
  "main": "src/index.ts",
  // Newest date the pinned workerd (wrangler 4.136.2 -> workerd 1.20260921) supports.
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // One container class per size and use. Runs go on `standard-1` unless the
  // catalog entry asks for `standard-2`. Builds use Sandbox and LargeSandbox,
  // which refuse requests addressed to api.cloudflare.com and never hold a
  // Cloudflare credential; a self-deploying app's installer deploys through the
  // API with the app's token, so its runs use classes of their own
  // (src/sandbox.ts), up to two containers of each size at once. The image tag
  // is the sandbox Worker's own version and is never reused (the release
  // config stamps it; this one is for local use).
  "containers": [
    {
      "name": "appflare-sandbox-standard-1",
      "class_name": "Sandbox",
      "image": "docker.io/mendylanda/appflare-sandbox:0.1.8",
      "instance_type": "standard-1",
      "max_instances": 2
    },
    {
      "name": "appflare-sandbox-standard-2",
      "class_name": "LargeSandbox",
      "image": "docker.io/mendylanda/appflare-sandbox:0.1.8",
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "name": "appflare-sandbox-self-deploying-standard-1",
      "class_name": "SelfDeployingSandbox",
      "image": "docker.io/mendylanda/appflare-sandbox:0.1.8",
      "instance_type": "standard-1",
      "max_instances": 2
    },
    {
      "name": "appflare-sandbox-self-deploying-standard-2",
      "class_name": "LargeSelfDeployingSandbox",
      "image": "docker.io/mendylanda/appflare-sandbox:0.1.8",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "LargeSandbox", "class_name": "LargeSandbox" },
      { "name": "SelfDeployingSandbox", "class_name": "SelfDeployingSandbox" },
      { "name": "LargeSelfDeployingSandbox", "class_name": "LargeSelfDeployingSandbox" }
    ]
  },
  // Append only: a deployed sandbox Worker is at one of these tags.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sandbox", "LargeSandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["SelfDeployingSandbox", "LargeSelfDeployingSandbox"] }
  ],
  // The id of the version answering, which info() reports: every secret the
  // manager stores here deploys a new version, and the manager waits for it to
  // answer before it starts a run.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Build outputs and logs, under builds/<installId>/<version>/.
  "r2_buckets": [{ "binding": "BUILDS", "bucket_name": "appflare-builds" }],
  "vars": {
    // The sandbox Worker's version; also the tag of the image it runs. The release
    // config replaces it with the release version.
    "APPFLARE_VERSION": "0.0.0-dev"
  }
}
