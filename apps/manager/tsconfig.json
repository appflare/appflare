{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // worker-configuration.d.ts (generated by `pnpm cf-typegen`) carries the
    // Workers runtime types and `Env`; vite/client types `?raw`/`?url` imports;
    // the pool-workers types add `cloudflare:test` for the tests.
    "types": ["vite/client", "@cloudflare/vitest-pool-workers/types"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "scripts",
    "worker-configuration.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.dom.config.ts",
    "drizzle.config.ts"
  ]
}
