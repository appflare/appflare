# Response headers for the static site (Workers static assets reads this file
# and does not serve it).
#
# No page of the site may be shown inside another site's frame: /my/ asks a
# visitor to remember an address with one click, and a hidden frame could
# trick them into that click.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# The build's own files: scripts, styles, images and the icon copies, each
# named by its content, so a new version is a new address and the old one can
# be kept for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The Install badge is shown in READMEs on other sites (GitHub proxies and
# caches it), so it may be loaded from anywhere and cached for a day.
/badge.svg
  Cache-Control: public, max-age=86400
  Cross-Origin-Resource-Policy: cross-origin

# Appflare's own install button, for README links to the hosted installer.
/deploy-badge.svg
  Cache-Control: public, max-age=86400
  Cross-Origin-Resource-Policy: cross-origin

# The front page points agents at the site's machine-readable indexes
# (RFC 8288): the Markdown index of every page, and the agent skills.
/
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"
