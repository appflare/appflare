{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // Nothing here is published as a library, and Starlight's content schema
    // types cannot be named in a declaration file.
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  },
  // `.astro/types.d.ts` is generated by `astro sync` (run by the typecheck
  // script) and declares the `astro:content` module.
  "include": [".astro/types.d.ts", "src", "astro.config.ts", "vitest.config.ts"],
  "exclude": ["dist"]
}
